# local 开启当前 API 的开发 CORS，适合 Expo Web 联调。
LOOP_ENV=local
RUST_LOG=info
LOOP_LOG_DIR=/app/log
MEILISEARCH_URL=http://search:7700
LOOP_EVENT_SEARCH_INDEX_UID=events_v1
LOOP_EMAIL_FROM=Loop <no-reply@example.com>
LOOP_SMTP_SENDER=replace-with-smtp-user
LOOP_SMTP_DOMAIN=smtp.example.com
LOOP_S3_BUCKET=loop-dev
LOOP_S3_REGION=us-east-1
LOOP_S3_ENDPOINT_URL=http://minio:9000
# 以下两个地址由客户端使用；真机调试时改为运行 port-forward 的电脑局域网 IP。
LOOP_S3_PRESIGN_ENDPOINT_URL=http://127.0.0.1:9000
LOOP_S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/loop-dev
LOOP_S3_KEY_PREFIX=media
LOOP_S3_FORCE_PATH_STYLE=true
# 启用 observability 后取消下一行注释，并重启三个业务 Deployment。
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317
