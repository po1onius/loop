# kubectl --from-env-file 读取；值不要加 shell 引号，不支持变量展开。
# 替换所有 replace-*，连接串内密码需与对应组件密码一致并进行 URL 编码。
POSTGRES_USER=loop
POSTGRES_DB=loop
POSTGRES_PASSWORD=replace-postgres-password
DATABASE_URL=postgresql://loop:replace-postgres-password@db:5432/loop
REDIS_PASSWORD=replace-redis-password
REDIS_URL=redis://:replace-redis-password@cache:6379
RABBITMQ_DEFAULT_USER=loop
RABBITMQ_DEFAULT_PASS=replace-rabbitmq-password
RABBITMQ_URL=amqp://loop:replace-rabbitmq-password@rabbitmq:5672/%2f
MEILI_MASTER_KEY=replace-meilisearch-key-at-least-16-bytes
LOOP_S3_ACCESS_KEY_ID=loopadmin
LOOP_S3_SECRET_ACCESS_KEY=replace-s3-secret-key
LOOP_SMTP_TOKEN=replace-smtp-token
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-grafana-password
# 高德 Web 端 (JS API)，同时留空时关闭地图选点。
LOOP_AMAP_JS_KEY=
LOOP_AMAP_SECURITY_CODE=
