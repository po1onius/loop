COMPOSE_FILE='compose.yaml:compose.seaweedfs.yaml'
LOOP_HOST_CONFIG_FILE='./examples/loop-api-svc.example.toml'
LOOP_HOST_SECRETS_DIR='./secrets'
LOOP_HOST_LOG_DIR='../../srv/log'
LOOP_API_SVC_PORT='3000'
LOOP_REALTIME_SVC_PORT='3010'
LOOP_PG_PORT='5132'
PGDATABASE='loop'
PGUSER='postgres'
PGPASSWORD='wdnmd'
LOOP_REDIS_PORT='6319'
LOOP_REDIS_PASSWORD='loopredis123'
LOOP_MEILISEARCH_PORT='7700'
LOOP_MEILISEARCH_MASTER_KEY='loop-local-meilisearch-master-key'
LOOP_EVENT_SEARCH_INDEX_UID='events_v1'
LOOP_RABBITMQ_PORT='5672'
LOOP_RABBITMQ_MANAGEMENT_PORT='15672'
LOOP_RABBITMQ_USER='loop'
LOOP_RABBITMQ_PASSWORD='looprabbit123'
LOOP_RABBITMQ_URL='amqp://loop:looprabbit123@rabbitmq:5672/%2f'
LOOP_EMAIL_FROM='Loop <no-reply@example.com>'
LOOP_SMTP_SENDER='smtp-user'
LOOP_SMTP_DOMAIN='smtp.example.com'
LOOP_SMTP_TOKEN='local-smtp-token'
LOOP_S3_BUCKET='loop-local'
LOOP_S3_REGION='us-east-1'
LOOP_S3_API_PORT='9000'
# API 容器访问地址；make backend-up 的宿主进程使用下面的 ENDPOINT_URL。
LOOP_S3_INTERNAL_ENDPOINT_URL='http://seaweedfs:8333'
LOOP_S3_ENDPOINT_URL='http://127.0.0.1:9000'
# 客户端直传地址；真机调试时改成电脑局域网 IP。
LOOP_S3_PRESIGN_ENDPOINT_URL='http://127.0.0.1:9000'
LOOP_S3_PUBLIC_BASE_URL='http://127.0.0.1:9000/loop-local'
LOOP_S3_KEY_PREFIX='media'
LOOP_S3_FORCE_PATH_STYLE='true'
LOOP_S3_ACCESS_KEY_ID='loopadmin'
LOOP_S3_SECRET_ACCESS_KEY='loopadmin123'

# FCM: leave project empty to disable system delivery during local development.
LOOP_FCM_PROJECT_ID=''
# For make backend-run, set an absolute path readable by the host worker.
# GOOGLE_APPLICATION_CREDENTIALS='/absolute/path/firebase-service-account.json'
# Compose reads deploy/standalone/secrets/firebase/service-account.json instead.
